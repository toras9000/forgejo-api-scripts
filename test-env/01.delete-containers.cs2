#!/usr/bin/env -S dotnet run --file
#:package Lestaly.General@0.147.0
using Lestaly;
using Lestaly.Cx;

return await Paved.ProceedAsync(async () =>
{
    Console.WriteLine("テスト環境の削除 ...");
    var composeFile = ThisSource.RelativeFile("./docker/compose.yml");
    await "docker".args("compose", "--file", composeFile, "down", "--remove-orphans", "--volumes").result().success();

    Console.WriteLine("テストファイルの削除 ...");
    ThisSource.RelativeDirectory("./docker/assets/runner/services").DeleteRecurse();
});

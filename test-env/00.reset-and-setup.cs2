#!/usr/bin/env -S dotnet run --file
#:package Lestaly.General@0.147.0
using Lestaly;
using Lestaly.Cx;

return await Paved.ProceedAsync(async () =>
{
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("01.delete-containers.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("02.restart-containers.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("11.init-setup.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("12.generate-admin-api-key.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("13.create-users.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("14.generate-users-api-key.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("15.generate-token-to-secrets.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("19.create-default-quota-group.cs2"), "--", "--no-pause").echo().result().success();
    await "dotnet".args("run", "--file", ThisSource.RelativeFile("21.setup-runner.cs2"), "--", "--no-pause").echo().result().success();
});

{
    "dotnet.projects.enableFileBasedPrograms": true,
    "dotnet.server.useOmnisharp": false,
    "files.associations": {
        "*.cs1": "csharp",
        "*.cs2": "csharp",
    },
    "json.schemas": [
        {
            "fileMatch": [
                "*.jsonc"
            ],
            "schema": {
                "allowTrailingCommas": true,
            },
        },
    ],
}